# Alpaca API Configuration (Paper Trading)
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# IMPORTANT: This system is configured for PAPER TRADING ONLY
# The orchestrator will verify the URL contains "paper" for safety

# --- Fortress operator / compliance gates (optional) ---
# Execution mode: autonomous (default) submits approved entries from screen/sniper.
# human_in_loop queues approved entries to data/pending_execution_queue.json — run: python3 orchestrator.py execute_pending
# FORTRESS_EXECUTION_MODE=autonomous
# FORTRESS_EXECUTION_MODE=human_in_loop
#
# FORTRESS_TRADING_HALT=1                    # Block all broker submissions (pre-trade gate)
# FORTRESS_MAX_ORDER_NOTIONAL_USD=25000      # Per-order estimated notional cap
# FORTRESS_MAX_ORDER_QTY=5000                # Per-order quantity cap
# FORTRESS_LIVE_TRADING_ACK=I_ACCEPT_LIVE_RISK  # Required only if ALPACA_BASE_URL is NOT paper
#
# File-backed kill switch (also blocks via pre_trade_gate; no systemd reload needed):
#   POST /api/operator/halt  JSON {"active":true,"reason":"..."}  (dashboard Basic auth)
# If FORTRESS_OPERATOR_TOKEN is set, same POST also accepts header X-Operator-Token, or use dashboard auth.
#
# FORTRESS_ALERT_WEBHOOK_URL=https://hooks.slack.com/...   # Slack-compatible JSON webhook on halt/resume
# FORTRESS_DASHBOARD_USER=operator                         # Optional HTTP Basic for Command Center + APIs
# FORTRESS_DASHBOARD_PASS=change-me
#
# Audit bundle S3 (optional; requires boto3 + AWS creds):
# FORTRESS_AUDIT_S3_BUCKET=my-bucket
# FORTRESS_AUDIT_S3_PREFIX=audit-bundles/
#
# TradingView alert webhook (optional; public URL — set a secret):
# FORTRESS_TV_WEBHOOK_SECRET=long-random-string
# URL: POST https://YOUR_HOST:8083/api/hooks/tradingview?secret=...
# Setup: docs/TRADINGVIEW_WEBHOOK_SETUP.md (print to PDF from browser if needed)

# Anthropic API Configuration (for Claude Vision analysis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vision Analysis Settings
# Vision analysis costs ~$0.02 per chart
# Only used for high-confidence trades (>0.9) to improve entry timing

# MCP Server API Keys (Feb 2026 Cutting-Edge!)
# Twitter API v2 - Get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API - Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# FRED API (Federal Reserve Economic Data) - Get from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8765
