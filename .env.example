# Alpaca API Configuration (Paper Trading)
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# IMPORTANT: This system is configured for PAPER TRADING ONLY
# The orchestrator will verify the URL contains "paper" for safety

# Anthropic API Configuration (for Claude Vision analysis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vision Analysis Settings
# Vision analysis costs ~$0.02 per chart
# Only used for high-confidence trades (>0.9) to improve entry timing
