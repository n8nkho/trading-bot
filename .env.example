# Alpaca API Configuration (Paper Trading)
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview

# System time — US Eastern only (see config/system_timezone.json)
FORTRESS_SYSTEM_TZ=America/New_York

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# IMPORTANT: This system is configured for PAPER TRADING ONLY
# The orchestrator will verify the URL contains "paper" for safety

# Declarative runtime (agent toggles, default portfolio, Ollama hints):
# config/fortress_runtime.yaml (optional override path)
# FORTRESS_RUNTIME_CONFIG=/home/ubuntu/trading-bot/config/fortress_runtime.yaml
#
# Default book size for screen/snipe when argv omits portfolio (matches YAML defaults.portfolio_value_usd):
# FORTRESS_PORTFOLIO_VALUE=20000
#
# Entry timing (agents/entry_agent.py) — tune after `python3 orchestrator.py print_entry_skips`
# ENTRY_WINDOW_EXTEND_END_MINUTES=15   # extend 3:45 PM ET window end (0 = default)
# RSI for stock entries follows data/current_params.json (rsi_threshold) when present.
#
# LLM entry (paper): minimum confidence for BUY when provider is enabled (default 0.55)
# FORTRESS_LLM_ENTRY_MIN_CONFIDENCE=0.55
# After full exit, run lesson extraction in background (default on)
# FORTRESS_LLM_LEARNING_ON_EXIT=1
#
# Stock exit: default 4-tier balanced ladder + trailing stop after tier1 (see agents/exit_monitor.py).
# Optional: trailing drawdown from peak (ratio, default 0.01 = 1%)
# FORTRESS_TRAILING_STOP_PCT=0.01

# --- Guardrail stack (phased rollout) ---
# Phase 1: pre-live hard protections (observe first, then enforce in paper)
# FORTRESS_MAX_DRAWDOWN_FROM_PEAK=0.10
# FORTRESS_MAX_DAILY_LOSS=0.03
# FORTRESS_DRAWDOWN_GUARD_ENFORCE=0
# FORTRESS_ENABLE_CORRELATION_GUARD=0
# FORTRESS_MAX_CORRELATION_SCORE=0.70
# FORTRESS_MAX_SECTOR_CONCENTRATION_PCT=30
#
# Phase 2: runtime stability controls
# FORTRESS_MAX_PNL_CHANGE_PER_HOUR=0.05
# FORTRESS_VELOCITY_GUARD_ENFORCE=0
# FORTRESS_SHORT_SQUEEZE_GUARD=1
# FORTRESS_POSITION_AGING_GUARD=0
# FORTRESS_MAX_HOLD_DAYS_LONG=5
# FORTRESS_MAX_HOLD_DAYS_SHORT=2
# FORTRESS_DATA_QUALITY_ENFORCE=0
# FORTRESS_MAX_SPREAD_PCT=0.03
# FORTRESS_MAX_QUOTE_AGE_SECONDS=90
#
# Phase 3: evolution/event safety
# FORTRESS_EVOLUTION_REQUIRE_APPROVAL=1
# FORTRESS_EVOLUTION_MAX_PARAM_DELTA_PCT=0.20
# ET blackout windows for BUY submissions (comma-separated HH:MM-HH:MM ranges)
# FORTRESS_ENTRY_BLACKOUT_WINDOWS_ET=08:25-08:40,09:28-09:40,13:55-14:10

# --- Fortress operator / compliance gates (optional) ---
# Execution mode: autonomous (default) submits approved entries from screen/sniper.
# human_in_loop queues approved entries to data/pending_execution_queue.json — run: python3 orchestrator.py execute_pending
# FORTRESS_EXECUTION_MODE=autonomous
# FORTRESS_EXECUTION_MODE=human_in_loop
#
# FORTRESS_TRADING_HALT=1                    # Block all broker submissions (pre-trade gate)
# FORTRESS_MAX_ORDER_NOTIONAL_USD=25000      # Per-order estimated notional cap
# FORTRESS_MAX_ORDER_QTY=5000                # Per-order quantity cap
# FORTRESS_LIVE_TRADING_ACK=I_ACCEPT_LIVE_RISK  # Required only if ALPACA_BASE_URL is NOT paper
#
# File-backed kill switch (also blocks via pre_trade_gate; no systemd reload needed):
#   POST /api/operator/halt  JSON {"active":true,"reason":"..."}  (dashboard Basic auth)
# If FORTRESS_OPERATOR_TOKEN is set, same POST also accepts header X-Operator-Token, or use dashboard auth.
#
# FORTRESS_ALERT_WEBHOOK_URL=https://hooks.slack.com/...   # Slack-compatible JSON webhook on halt/resume
# FORTRESS_DASHBOARD_USER=operator                         # Optional HTTP Basic for Command Center + APIs
# FORTRESS_DASHBOARD_PASS=change-me
#
# Audit bundle S3 (optional; requires boto3 + AWS creds):
# FORTRESS_AUDIT_S3_BUCKET=my-bucket
# FORTRESS_AUDIT_S3_PREFIX=audit-bundles/
#
# TradingView alert webhook (optional; public URL — set a secret):
# FORTRESS_TV_WEBHOOK_SECRET=long-random-string
# URL: POST https://YOUR_HOST:8083/api/hooks/tradingview?secret=...
# Setup: docs/TRADINGVIEW_WEBHOOK_SETUP.md (print to PDF from browser if needed)

# Anthropic API Configuration (for Claude Vision analysis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vision Analysis Settings
# Vision analysis costs ~$0.02 per chart
# Only used for high-confidence trades (>0.9) to improve entry timing

# MCP Server API Keys (Feb 2026 Cutting-Edge!)
# Twitter API v2 - Get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API - Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# FRED API (Federal Reserve Economic Data) - Get from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8765

# --- License / tiers (see docs/DISTRIBUTION.md) ---
# Lane 1 (Oracle): FORTRESS_LICENSE_TIER=master
# Customers: tier from purchase OR file from Stripe webhook (below).
# FORTRESS_LICENSE_TIER=master
# FORTRESS_LICENSE_PATH=/home/ubuntu/trading-bot/data/stripe_license.json

# --- Stripe billing (optional; Lanes 2–3) — full guide: docs/BILLING_STRIPE.md ---
# Webhook URL in Stripe Dashboard: https://YOUR_PUBLIC_HOST:8083/api/billing/stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Map each Product’s recurring Price ID to a Fortress tier (exact match):
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_LICENSE_OUT_PATH=data/stripe_license.json
# Optional: for checkout.session.completed when subscription is a string id only:
# STRIPE_SECRET_KEY=sk_test_...
#
# Optional: show “Subscribe” links on /proof (see docs/STRIPE_CHECKOUT_AND_PORTAL.md)
# STRIPE_PAYMENT_LINK_STARTER=https://buy.stripe.com/...
# STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# STRIPE_PAYMENT_LINK_ENTERPRISE=https://buy.stripe.com/...
# STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/...

# --- Remediation / reliability (see agents & utils docs in repo) ---
# Walk-forward diagnostics (agents/walk_forward_validator.py)
# FORTRESS_WF_NUM_WINDOWS=4
# FORTRESS_WF_DROP_THRESHOLD_FRAC=0.5
#
# Cron heartbeat staleness multiplier vs manifest interval (deploy/cron_manifest.json)
# FORTRESS_CRON_HEARTBEAT_STALE_MULT=2
#
# Earnings intel LLM rate limit (requests per minute, token bucket)
# FORTRESS_EARNINGS_LLM_RPM=10
#
# Regime / sentiment gates (utils/regime_freshness.py, utils/pre_trade_gate.py)
# FORTRESS_REGIME_MAX_AGE_MINUTES_RTH=60
# FORTRESS_REGIME_STALE_BLOCK_RTH=1
# FORTRESS_SENTIMENT_MAX_AGE_MINUTES_RTH=45
#
# Hedge execution fault latch — block new BUYs until operator clears (create empty data/hedge_error_cleared.flag)
# FORTRESS_HEDGE_ERROR_BLOCK_ENTRIES=1
#
# Screener regime-aware RSI (RANGING uses RSI extremes vs momentum RSI rule)
# FORTRESS_SCREENER_REGIME_RSI_EXTREMES=1
