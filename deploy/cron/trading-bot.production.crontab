# Production crontab for trading-bot (Classic Fortress) — America/New_York wall times.
# Install: set REPO, then: crontab deploy/cron/trading-bot.production.crontab
#
# Entry window for orchestrator screen: 14:30–16:00 ET (see docs/ENTRY_WINDOW_AND_CRON.md).
# Screen runs at 14:35, 14:50, 15:05, and 15:35 ET inside the entry window.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
REPO=/home/ubuntu/trading-bot

# --- Core trading (orchestrator) ---
35 14 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
50 14 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
5 15 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
35 15 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
*/5 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh monitor >> $REPO/logs/orchestrator.log 2>&1

# --- Fortress agents (manifest-aligned) ---
*/30 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh regime_detector python3 -m agents.regime_detector >> $REPO/logs/regime.log 2>&1
0 */2 * * * TZ=America/New_York cd $REPO && ./scripts/cron_run.sh regime_detector_offhours python3 -m agents.regime_detector >> $REPO/logs/regime_offhours.log 2>&1
*/20 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh sentiment_velocity python3 -m agents.sentiment_velocity_agent >> $REPO/logs/sentiment_velocity.log 2>&1
*/30 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh options_flow python3 -m agents.options_flow_agent >> $REPO/logs/options_flow.log 2>&1
25,55 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh cross_asset python3 -m agents.cross_asset_agent >> $REPO/logs/cross_asset.log 2>&1
*/30 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screener python3 -m agents.screener_agent >> $REPO/logs/screener.log 2>&1
45 8 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh morning_briefing python3 -m agents.briefing_agent >> $REPO/logs/briefing_scheduled.log 2>&1
0 8 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh earnings_intel python3 -m agents.earnings_intel_agent >> $REPO/logs/earnings_intel.log 2>&1
30 16 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh earnings_intel_close python3 -m agents.earnings_intel_agent >> $REPO/logs/earnings_intel.log 2>&1
0 * * * * cd $REPO && ./scripts/cron_run.sh drift_detector python3 -m agents.drift_detector >> $REPO/logs/drift_detector.log 2>&1
*/15 * * * * cd $REPO && ./scripts/cron_run.sh ops_autofix python3 -m agents.ops_autofix_agent >> $REPO/logs/ops_autofix.log 2>&1
