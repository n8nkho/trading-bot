# Example crontab (America/New_York jobs — set TZ in crontab or use explicit offsets).
# 1) Set REPO to your clone (must match systemd/dashboard WorkingDirectory if used).
# 2) crontab -e and paste adapted lines, or: crontab deploy/cron/trading-bot.crontab.example
#
# Bot audit treats the *freshest* mtime among logs/orchestrator.log, screener.log, monitor.log,
# fortress.log as "core jobs" heartbeat — split append targets (e.g. screener.log + monitor.log) are OK.
#
# SHELL=/bin/bash
# PATH=/usr/local/bin:/usr/bin:/bin
# REPO=/home/ubuntu/trading-bot
#
# Fortress AI agents (UTC internally; use TZ=America/New_York for ET wall times):
# Reflection (~5 PM ET Mon–Fri): append data/reflection_log.json when FORTRESS_REFLECTION_ALLOW_WRITES=1
# 0 17 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 agents/reflection_agent.py >> $REPO/logs/reflection.log 2>&1
#
# Pre-market briefing (~6 AM ET Mon–Fri): logs/briefing_YYYYMMDD.log; optional data/daily_risk_params.json
# 0 6 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 agents/briefing_agent.py >> $REPO/logs/briefing_scheduled.log 2>&1
#
# Cross-asset (5:30am ET — before briefing)
# 30 5 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.cross_asset_agent >> $REPO/logs/cross_asset.log 2>&1
#
# Regime detection (9:30am ET — market open)
# 30 9 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.regime_detector >> $REPO/logs/regime.log 2>&1
#
# Sentiment velocity (every 30min during market hours)
# */30 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.sentiment_velocity_agent >> $REPO/logs/sentiment_velocity.log 2>&1
#
# Options flow (every 15min during market hours)
# */15 9-16 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.options_flow_agent >> $REPO/logs/options_flow.log 2>&1
#
# Earnings intel (every 5min earnings window)
# */5 16-21 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.earnings_intel_agent >> $REPO/logs/earnings_intel.log 2>&1
#
# Prompt evolution (5:30pm ET — after reflection)
# 30 17 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.prompt_evolution_agent >> $REPO/logs/prompt_evolution.log 2>&1
#
# Regime re-check (every 2 hours during market)
# 0 10,12,14,16 * * 1-5 TZ=America/New_York cd $REPO && ./venv/bin/python3 -m agents.regime_detector >> $REPO/logs/regime.log 2>&1
#
# Entry critique loop runs inside orchestrator when FORTRESS_CRITIQUE_LOOP_ENABLED=1 (no separate cron).
#
# Recovery after downtime (manual or extra cron slot):
#   $REPO/scripts/cron_run.sh ops_recovery >> $REPO/logs/orchestrator.log 2>&1
#
# --- Production schedule (VM) — see deploy/cron/trading-bot.production.crontab and docs/ENTRY_WINDOW_AND_CRON.md ---
# Entry window 14:30-16:00 ET — screen at 14:35 and 15:05 ET:
# 35 14 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
# 5 15 * * 1-5 TZ=America/New_York cd $REPO && ./scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
#
# --- Legacy example (edit times as needed) ---
# Daily screen (~3 PM ET weekday): minute hour dom mon dow
# 0 15 * * 1-5 $REPO/scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
#
# Optional: enable auto-promotion check after each screen run (safe no-op when not ready).
# 0 15 * * 1-5 FORTRESS_UPLIFT_AUTO_PROMOTE_AFTER_SCREEN=1 FORTRESS_UPLIFT_REQUIRED_CLEAN_SESSIONS=5 $REPO/scripts/cron_run.sh screen >> $REPO/logs/orchestrator.log 2>&1
#
# Position monitor every 5 min, market hours (ET): align host TZ=America/New_York or use UTC offsets.
# */5 9-16 * * 1-5 $REPO/scripts/cron_run.sh monitor >> $REPO/logs/orchestrator.log 2>&1
#
# Intraday sniper (log to logs/sniper.log)
# 1-59/5 9-16 * * 1-5 $REPO/scripts/cron_run.sh snipe >> $REPO/logs/sniper.log 2>&1
#
# Fortress / hedge refresh (daily)
# 0 0 * * * $REPO/scripts/cron_run.sh fortress >> $REPO/logs/orchestrator.log 2>&1
#
# Sector rotation execution (first day of month; executor self-guards for trading day logic)
# 35 9 1 * * $REPO/scripts/cron_run.sh execute_sector_rotation >> $REPO/logs/sector_executor.log 2>&1
#
# Geographic allocation execution (first Monday window each month)
# 40 9 1-7 * 1 $REPO/scripts/cron_run.sh execute_geographic_allocation >> $REPO/logs/geographic_executor.log 2>&1
#
# Daily intelligence brief after close (self-QA + continuous improvement report)
# 0 17 * * 1-5 $REPO/scripts/cron_run.sh generate_intelligence_brief >> $REPO/logs/intelligence.log 2>&1
#
# Daily recursive evolution cycle (paper-safe by default; dry-run unless FORTRESS_EVOLUTION_ALLOW_WRITES=1)
# 5 17 * * 1-5 $REPO/scripts/cron_run.sh evolve >> $REPO/logs/evolution.log 2>&1
#
# Ops AutoFix (guarded rollout):
# 1) Dry-run first (recommended for first 1-2 days): writes report only; no state/log mutations.
# 10 * * * * $REPO/scripts/cron_run.sh ops_autofix --dry-run >> $REPO/logs/ops_autofix.log 2>&1
#
# 2) Promote to apply mode after dry-run review:
# 10 * * * * $REPO/scripts/cron_run.sh ops_autofix >> $REPO/logs/ops_autofix.log 2>&1
