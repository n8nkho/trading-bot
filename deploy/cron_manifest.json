{
  "version": 2,
  "description": "Production cron_run.sh jobs — heartbeat staleness uses 2× expected_interval_minutes (see utils/cron_heartbeat.py).",
  "jobs": [
    {
      "job_name": "regime_detector",
      "schedule": "*/30 9-16 * * 1-5 America/New_York",
      "script_path": "scripts/cron_run.sh regime_detector python3 -m agents.regime_detector",
      "expected_duration_seconds": 120,
      "expected_interval_minutes": 30
    },
    {
      "job_name": "regime_detector_offhours",
      "schedule": "0 */2 * * * America/New_York",
      "script_path": "scripts/cron_run.sh regime_detector_offhours python3 -m agents.regime_detector",
      "expected_duration_seconds": 120,
      "expected_interval_minutes": 120
    },
    {
      "job_name": "sentiment_velocity",
      "schedule": "*/20 9-16 * * 1-5 America/New_York",
      "script_path": "scripts/cron_run.sh sentiment_velocity python3 -m agents.sentiment_velocity_agent",
      "expected_duration_seconds": 180,
      "expected_interval_minutes": 20
    },
    {
      "job_name": "options_flow",
      "schedule": "*/30 9-16 * * 1-5 America/New_York",
      "script_path": "scripts/cron_run.sh options_flow python3 -m agents.options_flow_agent",
      "expected_duration_seconds": 180,
      "expected_interval_minutes": 30
    },
    {
      "job_name": "cross_asset",
