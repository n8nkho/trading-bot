      "expected_interval_minutes": 1440
    },
    {
      "job_name": "earnings_intel",
      "schedule": "0 8 * * 1-5 America/New_York",
      "script_path": "scripts/cron_run.sh earnings_intel python3 -m agents.earnings_intel_agent",
      "expected_duration_seconds": 600,
      "expected_interval_minutes": 480
    },
    {
      "job_name": "earnings_intel_close",
      "schedule": "30 16 * * 1-5 America/New_York",
