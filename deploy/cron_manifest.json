      "expected_duration_seconds": 120,
      "expected_interval_minutes": 60
    },
    {
      "job_name": "ops_autofix",
      "schedule": "*/15 * * * *",
      "script_path": "scripts/cron_run.sh ops_autofix python3 -m agents.ops_autofix_agent",
