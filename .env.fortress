# Fortress runtime feature flags
# Source this file in ~/.bashrc or systemd service:
# source /home/ubuntu/trading-bot/.env.fortress

export FORTRESS_CRITIQUE_LOOP_ENABLED=1
export FORTRESS_REFLECTION_ALLOW_WRITES=1
export FORTRESS_BRIEFING_ALLOW_WRITES=1
export FORTRESS_RECURSIVE_SCREENER_ENABLED=1
export FORTRESS_RECURSIVE_SCREENER_LLM_DRY_RUN=1
