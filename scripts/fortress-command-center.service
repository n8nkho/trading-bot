# Fortress Command Center - systemd unit
# Install: sudo cp scripts/fortress-command-center.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable fortress-command-center
#          sudo systemctl start fortress-command-center
# Then:    systemctl status fortress-command-center
#          systemctl stop fortress-command-center  (to stop)
# Logs:    journalctl -u fortress-command-center -f

[Unit]
Description=Fortress Trading Bot Command Center
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-bot
ExecStart=/home/ubuntu/trading-bot/venv/bin/python dashboard/command_center.py
Restart=always
RestartSec=5
Environment=COMMAND_CENTER_PORT=8083

# Load .env from project root (app already uses load_dotenv)
EnvironmentFile=-/home/ubuntu/trading-bot/.env

[Install]
WantedBy=multi-user.target
